# ──────────────────────────────────────────────────────────────────────────
# Environment variables — real values go in Vercel project settings
# (Settings → Environment Variables) and .env.local locally.
# NEVER commit real values to this repo.
# ──────────────────────────────────────────────────────────────────────────

# Contact form (Resend) — used in Phase: contact form
RESEND_API_KEY=
# Where contact-form submissions are delivered — Phase: contact form
CONTACT_TO_EMAIL=

# GitHub GraphQL API for activity/graph data — Phase: dashboard details
GITHUB_TOKEN=
GITHUB_USERNAME=

# Public site URL — Phase: SEO/metadata + sitemap. Set to your Vercel URL.
NEXT_PUBLIC_SITE_URL=

# Public links shown in the footer — Phase: launch polish
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
